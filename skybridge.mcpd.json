{
  "name": "flowera-procurement-agent",
  "version": "0.1.0",
  "runtime": "skybridge",
  "status": "live-fetch-prototype",
  "description": "Conversational German flower search and procurement UI using live merchant page fetching.",
  "entry": {
    "type": "static-ui",
    "path": "index.html"
  },
  "tools": [
    {
      "name": "aggregator_flower_search",
      "description": "Compares flower offers across 24blooms, Fleurop, Blume2000, Amazon.de, and Rewe.",
      "mode": "live-page-fetch",
      "requiredSlots": ["flower_type", "budget_range", "delivery_address", "delivery_date"],
      "refinementSlots": ["occasion", "relationship_to_recipient", "loved_colors", "avoided_colors", "visual_style"]
    }
  ],
  "views": [
    {
      "name": "FlowerAggregatorView",
      "path": "index.html",
      "presentation": "chat-embedded-horizontal-offer-cards"
    }
  ],
  "deployment": {
    "target": "skybridge-server",
    "state": "pending-real-credentials-or-deployment-tool"
  }
}
